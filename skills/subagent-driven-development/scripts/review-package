#!/usr/bin/env bash
# Generate a review package: change list, stat summary, and the net
# diff with extended context, written to a file the reviewer reads in one
# call. Using the recorded per-task BASE (not the immediate parent) keeps
# multi-change tasks intact.
#
# This repository uses Jujutsu (jj). BASE and HEAD are revsets -- commit IDs,
# change IDs, or bookmarks all work. jj's `BASE..HEAD` range has the same
# meaning as git's: everything reachable from HEAD that is not reachable from
# BASE.
#
# Usage: review-package PLAN_FILE BASE HEAD [OUTFILE]
# Default OUTFILE: <repo-root>/.superpowers/sdd/<plan-basename>/review-<base8>..<head8>.diff
# (named per range, so a re-review after fixes gets a distinct fresh file).
set -euo pipefail

if [ $# -lt 3 ] || [ $# -gt 4 ]; then
  echo "usage: review-package PLAN_FILE BASE HEAD [OUTFILE]" >&2
  exit 2
fi

plan=$1
base=$2
head=$3
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

# An unresolvable revset makes `jj log` exit non-zero, which is the check.
jj log --no-graph -r "$base" -T '""' >/dev/null 2>&1 || { echo "bad BASE: $base" >&2; exit 2; }
jj log --no-graph -r "$head" -T '""' >/dev/null 2>&1 || { echo "bad HEAD: $head" >&2; exit 2; }

short() { jj log --no-graph -r "$1" -T 'commit_id.short(8)'; }
count() { jj log --no-graph -r "$1" -T '"x\n"' | wc -l | tr -d ' '; }

# Range guards (exit 3): a wrong-branch HEAD yields a range that is empty or
# not rooted at BASE; either would silently produce a bogus review package.
# `BASE & ::HEAD` is empty unless BASE is an ancestor of HEAD.
[ "$(count "$base & ::$head")" -gt 0 ] || { echo "HEAD is not a descendant of BASE: ${base}..${head}" >&2; exit 3; }
[ "$(count "${base}..${head}")" -gt 0 ] || { echo "empty commit range: ${base}..${head}" >&2; exit 3; }

if [ $# -eq 4 ]; then
  out=$4
else
  # Invoke via bash rather than direct exec: some extractors (Python zipfile)
  # strip Unix exec bits when unpacking marketplace packages (#2040).
  dir=$("${BASH:-bash}" "$(cd "$(dirname "$0")" && pwd)/sdd-workspace" "$plan")
  out="$dir/review-$(short "$base")..$(short "$head").diff"
fi

{
  echo "# Review package: ${base}..${head}"
  echo
  echo "## Changes"
  jj log --no-graph -r "${base}..${head}" \
     -T 'commit_id.short(8) ++ " " ++ description.first_line() ++ "\n"'
  echo
  echo "## Files changed"
  jj diff --stat --from "$base" --to "$head"
  echo
  echo "## Diff"
  jj diff --git --context 10 --from "$base" --to "$head"
} > "$out"

changes=$(count "${base}..${head}")
echo "wrote ${out}: ${changes} change(s), $(wc -c < "$out" | tr -d ' ') bytes"
